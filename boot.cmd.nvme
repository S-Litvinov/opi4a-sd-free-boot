# Orange Pi 4A NVMe direct boot — Hermes/Qwen3.8-Flash-Next + Sergei Litvinov
# Placeholders: <NVME_ROOT_UUID> = ext4 UUID of your NVMe rootfs partition.
# v2 = v1 (CC.EN reset before handoff) + settle delay + retry (NVMe large reads
# time out during the first ~20 s after power-on).

setenv bootargs "root=UUID=<NVME_ROOT_UUID> rootwait rootfstype=ext4 earlycon=uart8250,mmio32,0x02500000 console=ttyAS0,115200 console=tty1 consoleblank=0 loglevel=4 clk_ignore_unused swiotlb=65536 splash=verbose net.ifnames=0 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"

echo NVMe boot v2
pci enum
nvme scan
sleep 8
if load nvme 0:1 0x41000000 /boot/uImage; then echo kern-ok; else sleep 10; load nvme 0:1 0x41000000 /boot/uImage; fi
if load nvme 0:1 0x43000000 /boot/dtb/allwinner/sun55i-t527-orangepi-4a.dtb; then
	if load nvme 0:1 0x46000000 /boot/uInitrd; then
		mw.l 0x22100014 0
		fdt addr 0x43000000
		fdt resize 65536
		bootm 0x41000000 0x46000000:${filesize} 0x43000000
	fi
fi

echo NVMe boot FAILED - falling back to SD boot.scr.orig
mmc dev 1
if load mmc 1 0x49000000 boot.scr.orig; then
	source 0x49000000
fi
echo SD fallback FAILED - resetting
reset

# Recompile with:
#   mkimage -C none -A arm -T script -d boot.cmd.nvme boot.scr
# Deploy to BOTH: <NVMe rootfs>/boot/boot.scr  and  SD <bootpart>/boot/boot.scr
# (keep the stock SD script there as boot.scr.orig)
