# Orange Pi 4A T527 - boot kernel, dtb and initrd straight from NVMe - vendor U-Boot 2018.07 - v4
#
# Root cause of the NVMe read error status 13 - hex 0x13 is PRP Offset Invalid:
# the vendor NVMe driver takes its PRP list pool of 512 bytes from plain malloc, unaligned.
# When the pool straddles a 4K page boundary, every read command that needs more
# PRP entries than fit before the boundary is rejected by the SSD.
# Where the pool lands depends on the heap history - SD card in or out, HDMI and so on -
# hence it works with the card and fails without it.
# Upstream fix is U-Boot commit b21dcebfa6 nvme: Fix PRP Offset Invalid, year 2019.
# Hot-fix here: find struct nvme_dev in the heap, signature is the BAR0 pointers,
# and repoint its prp_pool field to a page-aligned scratch page at 0x48000000.
# If the struct cannot be found, fall back to 8K chunked loads: two pages per
# command need no PRP list at all, always safe, just slow.
# Every statement is ONE line on purpose, so it can be replayed on the serial console.

echo NVMe boot v4
if itest.s x${devtype} == xnvme; then echo nvme-scanned-by-distro; else pci enum; nvme scan; fi

setenv fixed 0; setenv prp none; setenv devp 0
setexpr.l a *0x22100030
if itest ${a} != 0; then setexpr e ${a} - 0x10000; else setenv e 0; fi
while itest ${a} != ${e}; do setexpr a ${a} - 4; if itest.l *${a} == 0x22101000; then setexpr b ${a} + 0x20; if itest.l *${b} == 0x22100000; then setexpr devp ${a} - 0xc; setenv a ${e}; fi; fi; done
if itest ${devp} != 0; then setexpr f ${devp} + 0x8c; setexpr g ${devp} + 0x98; setexpr h ${devp} + 0x94; if itest.l *${f} == 0x1000; then if itest.l *${g} == 0x40; then setexpr.l pool *${h}; setexpr prp ${pool} "&" 0xfff; mw.l ${h} 0x48000000; setenv fixed 1; echo prp-pool ${pool} moved to 0x48000000; fi; fi; fi
if itest.s x${fixed} == x0; then echo prp-fix NOT applied - using 8K chunked loads; fi

setenv bootargs "root=UUID=<NVME_ROOT_UUID> rootwait rootfstype=ext4 earlycon=uart8250,mmio32,0x02500000 console=ttyAS0,115200 console=tty1 consoleblank=0 loglevel=4 clk_ignore_unused swiotlb=65536 splash=verbose net.ifnames=0 spi-boot-v4 spiboot.prp=${prp} spiboot.fix=${fixed} cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"

setenv slowload 'setenv rc 0; if size nvme 0:1 ${fn}; then setenv sz ${filesize}; setenv p 0; setenv a ${la}; setenv rc 1; while itest ${p} < ${sz}; do if load nvme 0:1 ${a} ${fn} 0x2000 ${p}; then setexpr p ${p} + 0x2000; setexpr a ${a} + 0x2000; else setenv rc 0; setenv p ${sz}; fi; done; setenv filesize ${sz}; fi'
setenv getf 'setenv rc 0; if itest.s x${fixed} == x1; then if load nvme 0:1 ${la} ${fn}; then setenv rc 1; fi; fi; if itest.s x${rc} == x0; then echo 8K-chunk-load ${fn}; run slowload; fi'

setenv la 0x41000000; setenv fn /boot/uImage; run getf; setenv r1 ${rc}
setenv la 0x43000000; setenv fn /boot/dtb/allwinner/sun55i-t527-orangepi-4a.dtb; run getf; setenv r2 ${rc}
setenv la 0x46000000; setenv fn /boot/uInitrd; run getf; setenv r3 ${rc}; setenv rdsize ${filesize}
echo load-result ${r1}${r2}${r3}

if itest.s x${r1}${r2}${r3} == x111; then mw.l 0x22100014 0; fdt addr 0x43000000; fdt resize 65536; bootm 0x41000000 0x46000000:${rdsize} 0x43000000; fi

echo NVMe boot FAILED - trying SD boot.scr.orig
if load mmc 0 0x49000000 /boot/boot.scr.orig; then source 0x49000000; fi
echo SD fallback FAILED - reset in 10 s
sleep 10
reset

# Recompile:
# mkimage -C none -A arm -T script -d boot.cmd.nvme-v4 boot.scr
